# Supabase project credentials.
# URL and publishable key are safe in the browser; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Service-role key. Server-only: bypasses RLS, never expose to the client.
# Supabase dashboard > Project Settings > API Keys > secret / service_role.
SUPABASE_SECRET_KEY=sb_secret_...

# Where admin data comes from: "supabase" or "mock".
# Unset = supabase when SUPABASE_SECRET_KEY is present, otherwise mock.
ADMIN_DATA_SOURCE=supabase

# Admin panel login (see lib/admin/config.ts for the dev defaults).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
